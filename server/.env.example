# Copy to server/.env (gitignored) and fill in. Never commit .env; never put the key in app/.
# Node 22.9+ reads this file itself (npm run dev); tools/gen-audio.mjs reads it too.

# ElevenLabs API key (the server and tools/gen-audio.mjs).
ELEVENLABS_API_KEY=
# Voice of the device's pre-recorded clips (tools/gen-audio.mjs); also the app's fallback voice.
ELEVENLABS_VOICE_ID=
# Voice for the app's own speech (app-side checksum, status). Pick one that sounds clearly different
# from the device voice, so the two channels are easy to tell apart.
ELEVENLABS_APP_VOICE_ID=

# ElevenLabs agent that asks "Jack Miller or Jack Chen?" (printed by tools/setup-agent.mjs).
ELEVENLABS_AGENT_ID=

# Server port on 127.0.0.1 (the app's Vite dev server proxies /api here).
TK_SERVER_PORT=8787
# live = call ElevenLabs; canned = no ElevenLabs calls at all (same as npm run dev:canned).
TK_SERVER_MODE=live
# canned mode: what /api/stt returns (default "send 0.01 SOL to Henry").
TK_CANNED_TRANSCRIPT=
# Speech-to-text model (npm run probe confirms it works).
TK_STT_MODEL=scribe_v2
# repeat = one keyterms form field per term (default); json = one field holding a JSON array.
TK_STT_KEYTERMS_MODE=repeat
# Text-to-speech model for the app's speech (low latency).
TK_TTS_MODEL=eleven_flash_v2_5

# Payment requests: the name a payer sees ("Payment request from Henry"), up to 32 characters.
# Empty = "Taktile wallet" plus the start and end of the wallet address.
TK_REQUESTER_NAME=
