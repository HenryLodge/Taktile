{
    "name": "taktile-app",
    "private": true,
    "type": "module",
    "description": "Taktile companion web app: voice, transaction building, transports to the device or the simulator.",
    "engines": {
        "node": ">=22.9"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint . && prettier --check . && node scripts/check-no-malware.mjs",
        "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-timeout=20000 \"src/**/*.test.ts\"",
        "demo": "vite --mode demo"
    },
    "devDependencies": {
        "@eslint/js": "9.28.0",
        "@types/node": "22.15.30",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "4.7.0",
        "eslint": "9.28.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "prettier": "3.5.3",
        "typescript": "5.8.3",
        "typescript-eslint": "8.33.1",
        "vite": "6.4.5"
    },
    "dependencies": {
        "@elevenlabs/client": "1.34.0",
        "@fontsource-variable/inter": "5.3.0",
        "@solana/web3.js": "1.98.4",
        "buffer": "6.0.3",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    }
}
