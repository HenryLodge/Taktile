{
    "name": "taktile-app",
    "private": true,
    "type": "module",
    "description": "Taktile companion web app: voice, transaction building, transports to the device or the simulator.",
    "engines": {
        "node": ">=22.9"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint . && prettier --check .",
        "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
    },
    "devDependencies": {
        "@eslint/js": "9.28.0",
        "@types/node": "22.15.30",
        "eslint": "9.28.0",
        "prettier": "3.5.3",
        "typescript": "5.8.3",
        "typescript-eslint": "8.33.1",
        "vite": "6.4.5"
    },
    "dependencies": {
        "@solana/web3.js": "1.98.4"
    }
}
